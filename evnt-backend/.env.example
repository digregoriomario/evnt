# Server
PORT=4000
NODE_ENV=development

# Comma separated list of allowed origins for CORS (use * for any)
CORS_ORIGIN=*

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://evnt:evnt@localhost:5433/evnt?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Local testing only: moves event cleanup clock forward/backward in hours.
# Example: 74 means "backend cleanup behaves as if 3 days and 2 hours passed".
EVENT_CLEANUP_TIME_OFFSET_HOURS=0
