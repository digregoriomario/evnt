{
  "name": "evnt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST API for the Evnt mobile app",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "dev": "tsx src/scripts/check-port.ts && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "PRISMA_HIDE_UPDATE_MESSAGE=true prisma generate --no-hints",
    "prisma:push": "PRISMA_HIDE_UPDATE_MESSAGE=true prisma db push",
    "prisma:postgis": "PRISMA_HIDE_UPDATE_MESSAGE=true prisma db execute --file prisma/sql/postgis.sql --schema prisma/schema.prisma",
    "db:setup": "npm run prisma:push && npm run prisma:postgis",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/demo-accounts.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
